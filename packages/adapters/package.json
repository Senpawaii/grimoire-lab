  "description": "Agent adapters for @grimoire/core: Claude Code, omp, and a generic command adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senpawaii/grimoire-lab.git",
    "directory": "packages/adapters"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
